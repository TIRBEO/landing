# ── Database (MongoDB) ──
# Connection string for the waitlist DB. Leave empty to use the
# file fallback (data/waitlist.json) in local dev.
MONGODB_URI=""

# ── Admin dashboard (/waitlist/details) ──
# Password for the admin gate. Use a long random value in production.
ADMIN_PASSWORD="change-me"
# Secret used to HMAC-sign the admin session cookie. Use a long random value.
ADMIN_SECRET="change-me-too"

# ── Redis (shared rate limiting across instances) ──
# Leave empty to use the per-instance in-memory limiter.
# e.g. redis://default:password@host:6379
REDIS_URL=""

# ── Cloudflare Turnstile (captcha) ──
# BOTH keys must be set for the captcha to be enforced. If only one is
# present, enforcement is skipped (and the reason is logged server-side) so a
# half-configured captcha can never lock every visitor out of the site.
#
# Server-side verification secret from https://dash.cloudflare.com → Turnstile.
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
# Public site key (safe to expose in the browser).
# Prefer the NON-public name: Next.js inlines NEXT_PUBLIC_* at BUILD time, so
# a key added after the first deploy reads as empty and the widget vanishes
# while the server keeps rejecting tokens.
TURNSTILE_SITE_KEY="your-turnstile-site-key"
# Legacy build-inlined fallback, still honoured if TURNSTILE_SITE_KEY is unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Server-side kill switch — set to 1 to skip verification entirely.
TURNSTILE_DISABLED=""
# Set to 1 to hide the widget (tests / local dev). Also disables the server check.
NEXT_PUBLIC_DISABLE_TURNSTILE=""
