# ── Database (MongoDB) ──
# Connection string for the waitlist DB. Leave empty to use the
# file fallback (data/waitlist.json) in local dev.
MONGODB_URI=""

# ── Admin dashboard (/waitlist/details) ──
# Password for the admin gate. Use a long random value in production.
ADMIN_PASSWORD="change-me"
# Secret used to HMAC-sign the admin session cookie. Use a long random value.
ADMIN_SECRET="change-me-too"

# ── Redis (shared rate limiting across instances) ──
# Leave empty to use the per-instance in-memory limiter.
# e.g. redis://default:password@host:6379
REDIS_URL=""

# ── Cloudflare Turnstile (captcha) ──
# Server-side verification secret from https://dash.cloudflare.com → Turnstile.
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
# Public site key (safe to expose in the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
# Set to 1 to disable the widget (tests / local dev).
NEXT_PUBLIC_DISABLE_TURNSTILE=""
